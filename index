window.addEventListener('popstate',e=>{ const s=e.state||{route:'home',params:{}}; currentRoute=s.route; renderRoute(s.route,s.params||{}); });
function setActiveNav(route){ document.querySelectorAll('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.route===route)); }

function esc(s=''){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
function moduleTitle(id){return COURSE.modules.find(m=>m.id===id)?.title||'';}
function lessonById(id){return COURSE.lessons.find(l=>l.id===id);}
function projectById(id){return PROJECTS.find(p=>p.id===id);}
function statusIcon(s){return s==='completed'?'✓':s==='progress'?'▶':s==='available'?'○':'🔒';}
function titleForRoute(route){return ({home:'Macramé',course:'Curso',knots:'Nudos',progress:'Progreso',lesson:'Clase',exercise:'Práctica',quiz:'Comprobación',project:'Proyecto',settings:'Ajustes'})[route]||'Macramé';}

function lessonVisual(id,step=0){
  const ink='#6E5636', cord='#B9823F', light='#E9DDCA', green='#547A5D';
  const wrap=(body,label)=>`<div class="visual-card" role="img" aria-label="${esc(label)}"><svg viewBox="0 0 640 480" xmlns="http://www.w3.org/2000/svg"><rect width="640" height="480" fill="#FBF7EF"/><circle cx="560" cy="70" r="90" fill="#F1E8D9"/>${body}<text x="320" y="440" text-anchor="middle" font-family="system-ui,sans-serif" font-size="20" font-weight="700" fill="${ink}">${esc(label)}</text></svg></div>`;
  if(id==='m01-c01-introduccion') return wrap(`<rect x="120" y="90" width="400" height="24" rx="12" fill="${ink}"/><path d="M210 114v76c0 38 60 38 60 0v-76M370 114v76c0 38 60 38 60 0v-76" fill="none" stroke="${cord}" stroke-width="13" stroke-linecap="round"/><path d="M240 220c-80 55-25 125 80 95 105-30 160 40 80 95M400 220c80 55 25 125-80 95-105-30-160 40-80 95" fill="none" stroke="${green}" stroke-width="11" stroke-linecap="round"/>`,'Estructura básica del macramé');
  if(id==='m01-c02-materiales') return wrap(`<circle cx="180" cy="230" r="85" fill="none" stroke="${cord}" stroke-width="20"/><circle cx="180" cy="230" r="38" fill="${light}"/><path d="M245 280c80 10 120 60 170 65" fill="none" stroke="${cord}" stroke-width="14" stroke-linecap="round"/><circle cx="410" cy="180" r="34" fill="none" stroke="${ink}" stroke-width="10"/><circle cx="480" cy="180" r="34" fill="none" stroke="${ink}" stroke-width="10"/><path d="M432 205l-90 120M458 205l80 120" stroke="${ink}" stroke-width="12" stroke-linecap="round"/><rect x="285" y="85" width="250" height="40" rx="8" fill="${green}"/><path d="M310 85v20m35-20v13m35-13v20m35-20v13m35-13v20m35-20v13" stroke="#fff" stroke-width="5"/>`,'Cordón, tijeras y cinta métrica');
  if(id==='m01-c03-preparacion') return wrap(`<rect x="90" y="90" width="460" height="34" rx="8" fill="${green}"/><path d="M120 90v18m50-18v11m50-11v18m50-18v11m50-11v18m50-18v11m50-11v18m50-18v11" stroke="#fff" stroke-width="5"/><path d="M180 160v220M270 160v220M360 160v220M450 160v220" stroke="${cord}" stroke-width="12" stroke-linecap="round"/><path d="M155 250h320" stroke="${ink}" stroke-width="4" stroke-dasharray="12 12"/>`,'Cuatro cuerdas medidas y ordenadas');
  if(id==='m02-c01-alondra'){
    const phase=Math.min(Math.max(step,1),4);
    if(phase===1) return wrap(`<path d="M210 350V185c0-95 220-95 220 0v165" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><path d="M320 110v-45" stroke="${green}" stroke-width="7"/><path d="M300 86l20-22 20 22" fill="none" stroke="${green}" stroke-width="7"/>`,'1. Dobla la cuerda por la mitad');
    if(phase===2) return wrap(`<rect x="105" y="175" width="430" height="26" rx="13" fill="${ink}"/><path d="M245 360V220c0-90 150-90 150 0v140" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><path d="M320 145v-55" stroke="${green}" stroke-width="7"/><path d="M300 112l20-22 20 22" fill="none" stroke="${green}" stroke-width="7"/>`,'2. Lleva el bucle detrás del soporte');
    if(phase===3) return wrap(`<rect x="105" y="120" width="430" height="26" rx="13" fill="${ink}"/><path d="M235 380V205c0-80 170-80 170 0v48c0 80-170 80-170 0" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><path d="M270 245v100m100-100v100" stroke="${green}" stroke-width="8"/><path d="M255 322l15 22 15-22m70 0 15 22 15-22" fill="none" stroke="${green}" stroke-width="7"/>`,'3. Pasa los extremos por el bucle');
    return wrap(`<rect x="105" y="110" width="430" height="26" rx="13" fill="${ink}"/><path d="M245 136c0 90 150 90 150 0M245 136v245M395 136v245" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><path d="M225 255h190" stroke="${green}" stroke-width="6"/><path d="M245 240l-20 15 20 15m150-30 20 15-20 15" fill="none" stroke="${green}" stroke-width="6"/>`,'4. Ajusta ambos extremos por igual');
  }
  if(id==='m02-c02-medio-nudo') return wrap(`<path d="M235 90v300M285 90v300M355 90v300M405 90v300" stroke="${light}" stroke-width="12" stroke-linecap="round"/><path d="M235 105c0 95 30 150 170 185M405 105c0 95-30 150-170 185" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><path d="M320 180v100" stroke="${green}" stroke-width="7"/><path d="M300 260l20 22 20-22" fill="none" stroke="${green}" stroke-width="7"/>`,'Cruce del medio nudo');
  if(id==='m02-c03-nudo-plano') return wrap(`<path d="M270 80v320M305 80v320M335 80v320M370 80v320" stroke="${light}" stroke-width="11"/><path d="M220 130c30 0 48 38 85 55 37 17 78 17 115-10M420 245c-30 0-48 38-85 55-37 17-78 17-115-10" fill="none" stroke="${cord}" stroke-width="16" stroke-linecap="round"/><rect x="250" y="205" width="140" height="54" rx="27" fill="none" stroke="${ink}" stroke-width="7"/>`,'Dos medios nudos opuestos');
  return `<div class="lesson-image">🧶</div>`;
}

function youtubeId(url=''){ const m=String(url).match(/[?&]v=([^&]+)/); return m?m[1]:''; }
function videoCard(video){
  if(!video?.url) return '';
  const id=youtubeId(video.url), thumb=id?`https://i.ytimg.com/vi/${id}/hqdefault.jpg`:'';
  return `<section class="card video-card"><img src="${esc(thumb)}" alt="Vista previa: ${esc(video.title)}" loading="lazy"><div class="video-card-body"><small class="eyebrow">Vídeo tutorial</small><h3>${esc(video.title)}</h3><p class="muted">Se abre en YouTube y necesita conexión a internet.</p><a class="btn btn-secondary" target="_blank" rel="noopener" href="${esc(video.url)}">▶ Ver tutorial</a><a href="${esc(video.url)}" target="_blank" rel="noopener" class="muted" style="display:block;text-align:center;margin-top:12px;word-break:break-all">${esc(video.url)}</a></div></section>`;
}

function renderRoute(route='home',params={}){
  document.getElementById('page-title').textContent=titleForRoute(route);
  setActiveNav(['home','course','knots','progress'].includes(route)?route:'');
  if(route==='home') return renderHome();
  if(route==='course') return renderCourse();
  if(route==='knots') return renderKnots();
  if(route==='progress') return renderProgress();
  if(route==='lesson') return renderLesson(params.lessonId, params.step);
  if(route==='exercise') return renderExercise(params.lessonId);
  if(route==='quiz') return renderQuiz(params.lessonId, params.q||0, params.score||0);
  if(route==='project') return renderProject(params.projectId||'p01-llavero');
  if(route==='settings') return renderSettings();
  renderHome();
}

function renderHome(){
  const state=loadState(), p=progressSummary(), current=lessonById(state.currentLesson)||COURSE.lessons[0];
  const newUser=!state.started && state.completedLessons.length===0;
  const finished=state.completedLessons.length===COURSE.lessons.length;
  let main;
  if(finished){
    main=`<section class="card hero"><span class="tag">Curso piloto completado</span><h2>🎉 Has terminado esta ruta</h2><p class="muted">Puedes repasar cualquier clase o continuar con el proyecto.</p><button class="btn btn-primary" onclick="navigate('course')">Repasar curso</button><button class="btn btn-secondary" onclick="navigate('project',{projectId:'p01-llavero'})">Abrir proyecto</button></section>`;
  } else if(newUser){
    main=`<section class="card hero"><span class="tag">Nivel principiante</span><h2>Aprende macramé paso a paso</h2><p class="muted">Lecciones breves, práctica real y progreso guardado en este dispositivo.</p><button class="btn btn-primary" onclick="startCourse()">Empezar curso</button></section>`;
  } else {
    const stepText=state.currentStep?` · Paso ${state.currentStep+1}`:'';
    main=`<section class="card hero"><small class="eyebrow">Continuar aprendiendo</small><h2>${esc(current.title)}</h2><p class="muted">${esc(moduleTitle(current.module))}${stepText}</p><div class="progress-track"><div class="progress-fill" style="width:${Math.round(((state.currentStep||0)/Math.max(current.steps.length,1))*100)}%"></div></div><button class="btn btn-primary" onclick="navigate('lesson',{lessonId:'${current.id}',step:${state.currentStep||0}})">Continuar</button></section>`;
  }
  document.getElementById('view').innerHTML=main+`
    <section class="card"><h3>Tu progreso</h3><div class="metrics"><div class="metric"><strong>${p.completed}</strong><small>Clases</small></div><div class="metric"><strong>${p.knots}</strong><small>Nudos</small></div><div class="metric"><strong>${p.projects}</strong><small>Proyectos</small></div></div></section>
    <section class="card"><h3>Próximo objetivo</h3><p>${finished?'Proyecto: Llavero básico':esc(current.title)}</p><button class="btn btn-ghost" onclick="navigate('${finished?'project':'course'}'${finished?`,{projectId:'p01-llavero'}`:''})">Ver ${finished?'proyecto':'recorrido'}</button></section>`;
}
function startCourse(){saveState({started:true,currentLesson:COURSE.lessons[0].id,currentStep:0});navigate('lesson',{lessonId:COURSE.lessons[0].id,step:0});}

function renderCourse(){
  let html='';
  for(const m of COURSE.modules){
    html+=`<section class="card"><small class="eyebrow">${esc(m.id.toUpperCase())}</small><h2>${esc(m.title)}</h2>`;
    for(const l of COURSE.lessons.filter(x=>x.module===m.id)){
      const s=lessonStatus(l.id); html+=`<div class="lesson-row"><div class="status-dot">${statusIcon(s)}</div><div><strong>${esc(l.title)}</strong><div class="muted">${esc(l.englishTitle||'')} · ${esc(l.duration)} min</div></div><button ${s==='locked'?'disabled':''} onclick="${s==='locked'?`alert('Completa primero la clase anterior.')`:`navigate('lesson',{lessonId:'${l.id}',step:0})`}">${s==='completed'?'Repasar':s==='progress'?'Continuar':s==='locked'?'Bloqueada':'Abrir'}</button></div>`;
    }
    html+='</section>';
  }
  html+=`<section class="card"><small class="eyebrow">Proyecto piloto</small><h2>Llavero básico</h2><p class="muted">Aplica el nudo alondra y el nudo plano en una pieza real.</p><button class="btn btn-primary" onclick="navigate('project',{projectId:'p01-llavero'})">Ver proyecto</button></section>`;
  document.getElementById('view').innerHTML=html;
}

function renderLesson(id,step=0){
  const l=lessonById(id); if(!l) return navigate('course');
  const state=loadState(); if(!state.started) saveState({started:true,currentLesson:id,currentStep:step}); else saveState({currentLesson:id,currentStep:step,started:true});
  if(step===0){
    document.getElementById('view').innerHTML=`<section class="card hero"><span class="tag">${esc(l.difficulty)}</span><span class="tag">⏱ ${esc(l.duration)} min</span>${lessonVisual(id,0)}<h2>${esc(l.title)}</h2><p class="muted"><em>${esc(l.englishTitle||'')}</em></p><h3>Vas a aprender</h3><p>${esc(l.objective)}</p>${l.materials.length?`<h3>Necesitas</h3><ul>${l.materials.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}<h3>Antes de empezar</h3><p>${esc(l.explanation)}</p><button class="btn btn-primary" onclick="navigate('lesson',{lessonId:'${id}',step:1})">Empezar clase</button></section>${videoCard(l.video)}`; return;
  }
  const idx=step-1;
  if(idx<l.steps.length){
    const s=l.steps[idx];
    document.getElementById('view').innerHTML=`<section class="card"><small class="eyebrow">Paso ${step} de ${l.steps.length}</small><div class="stepper">${l.steps.map((_,i)=>`<span class="${i<=idx?'active':''}"></span>`).join('')}</div>${lessonVisual(id,step)}<h2>${esc(s.title)}</h2><p>${esc(s.text)}</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><button class="btn btn-ghost" onclick="navigate('lesson',{lessonId:'${id}',step:${Math.max(0,step-1)}})">← Anterior</button><button class="btn btn-primary" onclick="navigate('lesson',{lessonId:'${id}',step:${step+1}})">Siguiente →</button></div></section>`; return;
  }
  document.getElementById('view').innerHTML=`<section class="card"><h2>Repaso antes de practicar</h2>${lessonVisual(id,l.steps.length)}<h3>⚠️ Error frecuente</h3>${(l.mistakes||[]).map(m=>`<p><strong>${esc(m.title)}:</strong> ${esc(m.text)}</p>`).join('')}<h3>💡 Consejo</h3>${(l.tips||[]).map(t=>`<p>${esc(t)}</p>`).join('')}<button class="btn btn-primary" onclick="navigate('exercise',{lessonId:'${id}'})">Ir a la práctica</button></section>${videoCard(l.video)}`;
}

async function renderExercise(id){
  const l=lessonById(id); if(!l) return navigate('course');
  const photo=await getPracticePhoto(id); const url=photo?URL.createObjectURL(photo.blob):null;
  document.getElementById('view').innerHTML=`<section class="card"><small class="eyebrow">Tu práctica</small><h2>${esc(l.exercise.title)}</h2><p>${esc(l.exercise.text)}</p>${lessonVisual(id,l.steps.length)}<h3>Revisa tu trabajo</h3><div class="checklist">${l.selfAssessment.map((x,i)=>`<label><input type="checkbox" id="check-${i}"> <span>${esc(x)}</span></label>`).join('')}</div><h3>Fotografía <span class="tag">opcional</span></h3>${url?`<img class="photo-preview" src="${url}" alt="Práctica guardada"><button class="btn btn-ghost" onclick="removePhoto('${id}')">Eliminar fotografía</button>`:'<p class="muted">Puedes guardar una evidencia de tu práctica en este dispositivo.</p>'}<input id="photo-input" type="file" accept="image/*" capture="environment" style="display:none" onchange="handlePhoto('${id}',this.files[0])"><button class="btn btn-secondary" onclick="document.getElementById('photo-input').click()">📷 ${photo?'Cambiar':'Añadir'} fotografía</button><p class="muted"><small>La fotografía permanece en este dispositivo.</small></p><button class="btn btn-primary" onclick="completeExercise('${id}')">He terminado la práctica</button></section>`;
}
async function handlePhoto(id,file){if(!file)return; try{await savePracticePhoto(id,file); renderExercise(id);}catch(e){alert('No se pudo guardar la fotografía.');}}
async function removePhoto(id){await deletePracticePhoto(id);renderExercise(id);}
function completeExercise(id){const state=loadState();saveState({completedExercises:[...new Set([...state.completedExercises,id])]});navigate('quiz',{lessonId:id,q:0,score:0});}

let selectedChoice=null;
function renderQuiz(id,qIndex=0,score=0){
  const l=lessonById(id), questions=l?.quiz||[]; if(!l) return navigate('course');
  if(qIndex>=questions.length){saveQuizResult(id,score,questions.length); markLessonComplete(id); const next=lessonById(loadState().currentLesson); document.getElementById('view').innerHTML=`<section class="card hero"><h2>🎉 Clase completada</h2><p><strong>${esc(l.title)}</strong></p><div class="metrics"><div class="metric"><strong>${score}/${questions.length}</strong><small>Conceptos</small></div><div class="metric"><strong>✓</strong><small>Práctica</small></div><div class="metric"><strong>${progressSummary().completed}</strong><small>Clases</small></div></div>${next&&next.id!==l.id?`<p class="muted">Siguiente: ${esc(next.title)}</p><button class="btn btn-primary" onclick="navigate('lesson',{lessonId:'${next.id}',step:0})">Continuar</button>`:`<button class="btn btn-primary" onclick="navigate('project',{projectId:'p01-llavero'})">Ir al proyecto</button>`}<button class="btn btn-ghost" onclick="navigate('home')">Volver al inicio</button></section>`; return;
  }
  selectedChoice=null; const q=questions[qIndex];
  document.getElementById('view').innerHTML=`<section class="card"><small class="eyebrow">Pregunta ${qIndex+1} de ${questions.length}</small><h2>${esc(q.q)}</h2><div id="options">${q.options.map((o,i)=>`<button class="option" onclick="selectAnswer(${i})">${esc(o)}</button>`).join('')}</div><div id="quiz-feedback"></div><button id="check-answer" class="btn btn-primary" onclick="checkAnswer('${id}',${qIndex},${score})">Comprobar</button></section>`;
}
function selectAnswer(i){selectedChoice=i;document.querySelectorAll('.option').forEach((b,n)=>b.classList.toggle('selected',n===i));}
function checkAnswer(id,qIndex,score){
  if(selectedChoice===null){alert('Selecciona una respuesta.');return;}
  const q=lessonById(id).quiz[qIndex], ok=gradeQuestion(q,selectedChoice); const fb=document.getElementById('quiz-feedback'); fb.innerHTML=`<div class="feedback ${ok?'ok':'bad'}"><strong>${ok?'✅ Correcto':'Todavía no'}</strong><br>${esc(q.feedback)}</div>`;
  document.getElementById('check-answer').outerHTML=`<button class="btn btn-primary" onclick="navigate('quiz',{lessonId:'${id}',q:${qIndex+1},score:${score+(ok?1:0)}})">${qIndex+1===lessonById(id).quiz.length?'Terminar':'Siguiente'}</button>`;
}

function renderKnots(){
  document.getElementById('view').innerHTML=`<input class="search" id="knot-search" placeholder="Buscar nudo…" oninput="filterKnots(this.value)"><div id="knot-list"></div>`; filterKnots('');
}
function filterKnots(term){
  const list=KNOTS.filter(k=>(k.title+' '+k.englishTitle).toLowerCase().includes(term.toLowerCase()));
  document.getElementById('knot-list').innerHTML=list.length?list.map(k=>`<section class="card">${lessonVisual(k.lessonId,4)}<span class="tag">${esc(k.difficulty)}</span><h2>${esc(k.title)}</h2><p class="muted"><em>${esc(k.englishTitle)}</em></p><p>${esc(k.summary)}</p><button class="btn btn-primary" onclick="navigate('lesson',{lessonId:'${k.lessonId}',step:0})">${lessonStatus(k.lessonId)==='completed'?'Repasar':'Aprender'} este nudo</button></section>`).join(''):`<div class="empty">No encontramos ese nudo.</div>`;
}

async function renderProgress(){
  const p=progressSummary(), state=loadState(), photos=await listPracticePhotos();
  document.getElementById('view').innerHTML=`<section class="card"><h2>Tu progreso</h2><div class="progress-track"><div class="progress-fill" style="width:${p.percent}%"></div></div><p><strong>${p.percent}%</strong> · ${p.completed} de ${p.total} clases</p><div class="metrics"><div class="metric"><strong>${p.knots}</strong><small>Nudos</small></div><div class="metric"><strong>${p.projects}</strong><small>Proyectos</small></div><div class="metric"><strong>${photos.length}</strong><small>Fotos</small></div></div></section><section class="card"><h3>Clases</h3>${COURSE.lessons.map(l=>`<div class="lesson-row"><div class="status-dot">${state.completedLessons.includes(l.id)?'✓':'○'}</div><div><strong>${esc(l.title)}</strong><div class="muted">${state.completedLessons.includes(l.id)?'Completada':'Pendiente'}</div></div></div>`).join('')}</section><section class="card"><h3>Mis prácticas</h3>${photos.length?photos.map(p=>`<p>📷 ${esc(lessonById(p.lessonId)?.title||p.lessonId)} <span class="muted">${new Date(p.date).toLocaleDateString('es-ES')}</span></p>`).join(''):'<div class="empty">Aún no tienes fotografías guardadas.</div>'}</section>`;
}

function renderProject(id){
  const p=projectById(id); if(!p)return navigate('course'); const state=loadState(); const ready=p.prerequisites.every(x=>state.completedLessons.includes(x));
  document.getElementById('view').innerHTML=`<section class="card hero"><span class="tag">${esc(p.difficulty)}</span><span class="tag">⏱ ${esc(p.duration)}</span><h2>${esc(p.title)}</h2><p class="muted">${ready?'Ya tienes las técnicas necesarias.':'Puedes verlo ahora; recomendamos completar primero las técnicas indicadas.'}</p><h3>Materiales</h3><ul>${p.materials.map(x=>`<li>${esc(x)}</li>`).join('')}</ul><h3>Paso a paso</h3><ol>${p.steps.map(x=>`<li style="margin-bottom:8px">${esc(x)}</li>`).join('')}</ol><h3>Autoevaluación</h3><div class="checklist">${p.selfAssessment.map((x,i)=>`<label><input type="checkbox"> ${esc(x)}</label>`).join('')}</div><button class="btn btn-primary" onclick="completeProject('${p.id}')">Marcar proyecto como terminado</button></section>`;
}
function completeProject(id){const s=loadState();saveState({completedProjects:[...new Set([...s.completedProjects,id])]});navigate('progress');}

function renderSettings(){
  document.getElementById('view').innerHTML=`<section class="card"><h2>Ajustes</h2><h3>Privacidad</h3><p>El progreso y las fotografías se almacenan localmente en este dispositivo. No necesitas crear una cuenta.</p><h3>Reiniciar</h3><p class="muted">Esta acción elimina el progreso guardado. Las fotografías se pueden borrar desde cada práctica.</p><button class="btn btn-ghost" onclick="if(confirm('¿Reiniciar todo el progreso?')){resetState();navigate('home')}">Reiniciar progreso</button></section>`;
}

document.querySelectorAll('.nav-item').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.route)));
document.getElementById('settings-btn').addEventListener('click',()=>navigate('settings'));
const initial=(location.hash||'#home').slice(1);history.replaceState({route:initial,params:{}},'',location.hash||'#home');renderRoute(initial,{});

  </script>
</body>
