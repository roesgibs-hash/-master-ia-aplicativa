const STORAGE_KEY = 'macrame_app_state_v1';
const DEFAULT_STATE = {
  currentLesson: 'm01-c01-introduccion',
  currentStep: 0,
  completedLessons: [],
  completedExercises: [],
  quizResults: {},
  completedProjects: [],
  lastActivity: null,
  started: false
};
function loadState(){
  try { return { ...DEFAULT_STATE, ...(JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}) }; }
  catch { return { ...DEFAULT_STATE }; }
}
function saveState(patch){
  const state = { ...loadState(), ...patch, lastActivity: new Date().toISOString() };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  return state;
}
function resetState(){ localStorage.removeItem(STORAGE_KEY); return { ...DEFAULT_STATE }; }

const PHOTO_DB='macrame_photos_v1';
const PHOTO_STORE='photos';
function openPhotoDB(){
  return new Promise((resolve,reject)=>{
    const req=indexedDB.open(PHOTO_DB,1);
    req.onupgradeneeded=()=>{ const db=req.result; if(!db.objectStoreNames.contains(PHOTO_STORE)) db.createObjectStore(PHOTO_STORE,{keyPath:'id'}); };
    req.onsuccess=()=>resolve(req.result); req.onerror=()=>reject(req.error);
  });
}
async function resizeImage(file,maxSide=1400,quality=.82){
  const bitmap=await createImageBitmap(file); const scale=Math.min(1,maxSide/Math.max(bitmap.width,bitmap.height));
  const canvas=document.createElement('canvas'); canvas.width=Math.round(bitmap.width*scale); canvas.height=Math.round(bitmap.height*scale);
  canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);
  return new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));
}
async function savePracticePhoto(lessonId,file){
  const db=await openPhotoDB(); const blob=await resizeImage(file); const id=`${lessonId}-practice`;
  return new Promise((resolve,reject)=>{ const tx=db.transaction(PHOTO_STORE,'readwrite'); tx.objectStore(PHOTO_STORE).put({id,lessonId,date:new Date().toISOString(),blob}); tx.oncomplete=()=>resolve(id); tx.onerror=()=>reject(tx.error); });
}
async function getPracticePhoto(lessonId){
  const db=await openPhotoDB(); return new Promise((resolve,reject)=>{ const req=db.transaction(PHOTO_STORE).objectStore(PHOTO_STORE).get(`${lessonId}-practice`); req.onsuccess=()=>resolve(req.result||null); req.onerror=()=>reject(req.error); });
}
async function deletePracticePhoto(lessonId){ const db=await openPhotoDB(); return new Promise((resolve,reject)=>{ const tx=db.transaction(PHOTO_STORE,'readwrite'); tx.objectStore(PHOTO_STORE).delete(`${lessonId}-practice`); tx.oncomplete=resolve; tx.onerror=()=>reject(tx.error); }); }
async function listPracticePhotos(){ const db=await openPhotoDB(); return new Promise((resolve,reject)=>{ const req=db.transaction(PHOTO_STORE).objectStore(PHOTO_STORE).getAll(); req.onsuccess=()=>resolve(req.result||[]); req.onerror=()=>reject(req.error); }); }

function gradeQuestion(question, choiceIndex){ return choiceIndex === question.answer; }
function saveQuizResult(lessonId, score, total){ const state=loadState(); const quizResults={...state.quizResults,[lessonId]:{score,total,date:new Date().toISOString()}}; saveState({quizResults}); }

function lessonStatus(lessonId){
  const state=loadState();
  if(state.completedLessons.includes(lessonId)) return 'completed';
  const firstIncomplete=COURSE.lessons.find(l=>!state.completedLessons.includes(l.id));
  if(!firstIncomplete) return 'completed';
  if(lessonId===firstIncomplete.id) return state.currentLesson===lessonId && state.started ? 'progress' : 'available';
  return 'locked';
}
function markLessonComplete(lessonId){
  const state=loadState();
  const wasCompleted=state.completedLessons.includes(lessonId);
  const done=[...new Set([...state.completedLessons,lessonId])];
  const firstIncomplete=COURSE.lessons.find(l=>!done.includes(l.id));
  const patch={completedLessons:done};
  if(!wasCompleted){
    patch.currentLesson=firstIncomplete?firstIncomplete.id:lessonId;
    patch.currentStep=0;
    patch.started=false;
  }
  saveState(patch);
}
function progressSummary(){
  const state=loadState(); const total=COURSE.lessons.length; const completed=state.completedLessons.length; const knots=COURSE.lessons.filter(l=>l.type==='knot'&&state.completedLessons.includes(l.id)).length;
  return {completed,total,percent:Math.round((completed/Math.max(total,1))*100),knots,projects:state.completedProjects.length};
}

